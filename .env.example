DB_HOST=db
DB_PORT=3306
DB_NAME=oj
DB_USER=oj
DB_PASS=oj_secret
JWT_SECRET=change_me_jwt_secret_32chars_min
API_PORT=8080
WEB_PORT=3000
RATE_SUBMIT_PER_MIN=10
RATE_RUN_PER_MIN=20
# Port tu judge0.conf (Ruby): che do bao tri, cho doi ket qua, batch, callback.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=He thong dang bao tri
ENABLE_WAIT_RESULT=true
ENABLE_BATCHED_SUBMISSIONS=true
MAX_SUBMISSION_BATCH_SIZE=20
MAX_QUEUE_SIZE=100
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=20
ENABLE_COMPILER_OPTIONS=true
ENABLE_COMMAND_LINE_ARGUMENTS=true
ENABLE_CALLBACKS=true
CALLBACKS_MAX_TRIES=3
CALLBACKS_TIMEOUT=5
ENABLE_SUBMISSION_DELETE=false
